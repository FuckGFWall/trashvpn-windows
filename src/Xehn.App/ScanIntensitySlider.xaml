<UserControl x:Class="Xehn.App.ScanIntensitySlider" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xehn.App" Width="160" Focusable="False">
 <UserControl.Resources>
  <StaticResource x:Key="SliderThumbBackground" ResourceKey="Accent"/>
  <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="Accent"/>
 </UserControl.Resources>
 <StackPanel>
  <Slider x:Name="IntensityTrack" Minimum="0" Maximum="2" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Height="28" Foreground="{DynamicResource Accent}" ValueChanged="ValueChanged" AutomationProperties.Name="{local:Loc 优选强度}" AutomationProperties.HelpText="{local:Loc 低、中、高三档；拖动或使用左右方向键调整。}"/>
  <Grid Margin="0,-2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock x:Name="LowLabel" Text="{local:Loc 低}" FontSize="12" HorizontalAlignment="Left"/>
   <TextBlock x:Name="MediumLabel" Grid.Column="1" Text="{local:Loc 中}" FontSize="12" HorizontalAlignment="Center"/>
   <TextBlock x:Name="HighLabel" Grid.Column="2" Text="{local:Loc 高}" FontSize="12" HorizontalAlignment="Right"/>
  </Grid>
 </StackPanel>
</UserControl>
