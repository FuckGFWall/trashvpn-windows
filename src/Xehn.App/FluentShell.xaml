<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xehn.App">
 <!-- Scoped shell surfaces: the home, settings and log cards keep their own styles. -->
 <SolidColorBrush x:Key="NavigationPaneBrush" Color="#F3F3F3"/>
 <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#0C000000"/>
 <SolidColorBrush x:Key="NavigationHoverBrush" Color="#08000000"/>
 <SolidColorBrush x:Key="NavigationPressedBrush" Color="#10000000"/>
 <SolidColorBrush x:Key="ShellStrokeBrush" Color="#12000000"/>
 <SolidColorBrush x:Key="AboutSurfaceBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AboutFooterBrush" Color="#03000000"/>
 <!-- WPF only presents this adorner for keyboard navigation, not mouse clicks. -->
 <Style x:Key="NavKeyboardFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border CornerRadius="4" Margin="2" BorderThickness="1" BorderBrush="{DynamicResource InkBrush}"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Nav" TargetType="RadioButton">
  <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
  <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
  <Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="44"/>
  <Setter Property="FontWeight" Value="Light"/>
  <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="10,8,6,8"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="RadioButton">
    <Grid Background="Transparent">
     <Border x:Name="SelectionSurface" CornerRadius="4" Background="Transparent"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource NavigationHoverBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource NavigationSelectedBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource NavigationPressedBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="13"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="MaxWidth" Value="53"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Style.Triggers><DataTrigger Binding="{Binding Language}" Value="zh"><Setter Property="FontSize" Value="16"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="UpdateNav" TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
  <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#AB420D"/>
  <Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,8,0,4"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="6">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
     <TextBlock Text="&#xE8A7;" Foreground="{TemplateBinding Foreground}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="#973708"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.82"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AboutCardTitle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
  <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="AboutCard" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource AboutSurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeBrush}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="156"/>
 </Style>
 <Style x:Key="AboutIcon" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
  <Setter Property="FontSize" Value="20"/><Setter Property="Width" Value="24"/>
  <Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,8"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="AboutLink" TargetType="Hyperlink">
  <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  <Setter Property="TextDecorations" Value="{x:Null}"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="TextDecorations" Value="Underline"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="AboutActionSurface" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource AboutFooterBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeBrush}"/>
  <Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="CornerRadius" Value="0,0,7,7"/>
  <Setter Property="Margin" Value="-16,0,-16,-10"/><Setter Property="IsHitTestVisible" Value="False"/>
 </Style>
 <Style x:Key="AboutActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
  <Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="0"/>
  <Setter Property="Padding" Value="10,3"/>
 </Style>
 <Style TargetType="local:ResourceFeedbackButton" BasedOn="{StaticResource AboutActionButton}">
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Grid>
   <ContentPresenter x:Name="FeedbackLabel" Content="{Binding}" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <local:ProgressRing x:Name="FeedbackSpinner" Width="12" Height="12" Stroke="{DynamicResource Accent}" StrokeThickness="1.7" IsActive="{Binding IsWorking, RelativeSource={RelativeSource AncestorType=local:ResourceFeedbackButton}}" Visibility="Collapsed"/>
   <Path x:Name="FeedbackSuccess" Data="M 1,7 L 5,11 L 13,2" Width="12" Height="12" Stretch="Uniform" Stroke="#279453" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
  </Grid><DataTemplate.Triggers>
   <DataTrigger Binding="{Binding ShowSuccess, RelativeSource={RelativeSource AncestorType=local:ResourceFeedbackButton}}" Value="True"><Setter TargetName="FeedbackLabel" Property="Visibility" Value="Hidden"/><Setter TargetName="FeedbackSuccess" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding IsWorking, RelativeSource={RelativeSource AncestorType=local:ResourceFeedbackButton}}" Value="True"><Setter TargetName="FeedbackLabel" Property="Visibility" Value="Hidden"/><Setter TargetName="FeedbackSuccess" Property="Visibility" Value="Collapsed"/><Setter TargetName="FeedbackSpinner" Property="Visibility" Value="Visible"/></DataTrigger>
  </DataTemplate.Triggers></DataTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
