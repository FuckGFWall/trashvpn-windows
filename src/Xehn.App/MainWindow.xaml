<Window x:Class="Xehn.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xehn.App" Title="XEHN" Icon="{x:Static local:Branding.Image}" Width="800" Height="680" MinWidth="800" MaxWidth="800" MinHeight="680" MaxHeight="680" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
 <Grid Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{DynamicResource NavigationPaneBrush}">
   <Grid Margin="12,22,12,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="BrandGroup" HorizontalAlignment="Center" Margin="0,4,0,22"><Image x:Name="BrandIcon" Source="{x:Static local:Branding.Image}" Width="56" Height="56" Stretch="Uniform"/></StackPanel>
    <Grid x:Name="NavigationHost" Grid.Row="1" VerticalAlignment="Top">
    <StackPanel x:Name="NavigationItems">
     <RadioButton x:Name="HomeNav" GroupName="Navigation" IsChecked="True" Style="{StaticResource Nav}" Tag="Home" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:NavigationGlyph IsSelected="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="{local:Loc 首页}" Style="{StaticResource NavLabel}"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="Settings" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:NavigationGlyph IsSelected="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="{local:Loc 设置}" Style="{StaticResource NavLabel}"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="About" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:NavigationGlyph IsSelected="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" Margin="0,2,10,-2"/><TextBlock Text="{local:Loc 关于}" Style="{StaticResource NavLabel}"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="Logs" Checked="Navigate"><StackPanel Orientation="Horizontal"><local:NavigationGlyph IsSelected="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" Margin="0,2,10,-2"/><TextBlock Text="{local:Loc 日志}" Style="{StaticResource NavLabel}"/></StackPanel></RadioButton>
      <Button x:Name="AppUpdateNav" Content="{local:Loc 有更新}" Tag="{Binding AppDownloadUrl}" Click="OpenLink"
              Style="{StaticResource UpdateNav}" Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolVisibility}}" />
    </StackPanel>
    <Border x:Name="NavigationIndicator" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
    </Grid>
    <StackPanel x:Name="ConnectionStatus" Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal"><local:StatusDot x:Name="ConnectionDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" IsChecking="{Binding IsCheckingNodes}" IsConnected="{Binding IsConnected}" IdleBrush="{DynamicResource MutedBrush}" ActiveBrush="{DynamicResource Accent}"/><TextBlock x:Name="SidebarStatusText" Text="{local:Localize SidebarStatus}" MaxWidth="75" FontSize="12" TextTrimming="CharacterEllipsis"/><local:ProgressRing x:Name="StatusProgressRing" Width="12" Height="12" Margin="4,0,0,0" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" IsActive="{Binding IsStatusWorking}" Visibility="{Binding IsStatusWorking, Converter={StaticResource BoolVisibility}}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,0,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PageHeader" Visibility="Collapsed" Margin="0,4,28,12"><TextBlock x:Name="PageTitle" Text="{local:Loc 首页}" FontSize="24" FontWeight="SemiBold"/></Grid>
   <Grid x:Name="PageContent" Grid.Row="1">
     <Grid x:Name="HomeViewport" Margin="0,0,28,0">
     <Grid x:Name="HomePage" ToolTipService.IsEnabled="False">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ConnectionCard" Style="{StaticResource Card}" Padding="22,16,22,18">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ConnectionHeading" Text="{local:Localize ConnectionHeading}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,6,0,0"><Grid Width="146" Height="146">
         <local:WaterPowerSurface x:Name="PowerVisual" Width="146" Height="146" State="{Binding PowerState}" IdleBrush="{DynamicResource PowerIdleBrush}" AccentBrush="{DynamicResource Accent}"/>
         <Button x:Name="PowerButton" Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ToggleConnection" AutomationProperties.Name="{local:Localize PowerLabel}" Cursor="Hand">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="circle" CornerRadius="60" Background="Transparent"><Grid><Viewbox x:Name="PowerGlyph" Width="54" Height="54"><Grid Width="48" Height="48"><Path Data="M 13,9 A 18,18 0 1 0 35,9" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M 24,3 L 24,23" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Viewbox></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="circle" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="circle" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="circle" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
         </Button>
        </Grid></Viewbox>
        <StackPanel Grid.Row="2" x:Name="PreparationPanel" MaxWidth="420" HorizontalAlignment="Stretch" Margin="0,12,0,0">
         <StackPanel.Resources><Style x:Key="PreparationAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="7,3"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="26"/><Setter Property="FontSize" Value="11.5"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style></StackPanel.Resources>
         <Grid Height="34" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="PreparationCaption" Text="{local:Localize PreparationCaption}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,0,10,0" AutomationProperties.HelpText="{local:Localize PreparationCaption}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
           <Button x:Name="PausePreparationButton" Style="{StaticResource PreparationAction}" Content="{local:Localize PreparationActionLabel}" IsEnabled="{Binding CanTogglePreparation}" Click="TogglePreparation"/>
           <Button x:Name="RescanButton" Style="{StaticResource PreparationAction}" Content="{local:Loc 重新优选}" IsEnabled="{Binding CanRescan}" Click="RestartPreparation" Margin="5,0,0,0"/>
          </StackPanel>
         </Grid>
         <local:PreparationTrack FlowDirection="LeftToRight" x:Name="PreparationBar" Progress="{Binding PreparationProgress}" IsActive="{Binding PreparationActive}" IsReady="{Binding PreparationReady}" RegistrationComplete="{Binding RegistrationComplete}" Height="42" AccentBrush="{DynamicResource Accent}" TrackBrush="{DynamicResource LineBrush}" LabelBrush="{DynamicResource MutedBrush}" SurfaceBrush="{DynamicResource CardBrush}" AutomationProperties.Name="{local:Localize PreparationCaption}"/>
        </StackPanel>
        <Grid Grid.Row="3" x:Name="ModeSelectors" MaxWidth="440" HorizontalAlignment="Stretch" Margin="0,40,0,0" IsEnabled="{Binding CanChangeModes}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <local:ModeSwitch FlowDirection="LeftToRight" x:Name="CaptureSwitch" FirstText="{local:Loc 代理}" SecondText="TUN" IsSecondSelected="{Binding TunSelected, Mode=OneWay}" SelectionRequested="CaptureModeRequested"/>
         <local:ModeSwitch FlowDirection="LeftToRight" x:Name="RoutingSwitch" Grid.Column="2" FirstText="{local:Loc 全局}" SecondText="{local:Loc 分流}" IsSecondSelected="{Binding SplitSelected, Mode=OneWay}" SelectionRequested="RoutingModeRequested"/>
        </Grid>
       </Grid>
      </Border>
      <Grid x:Name="ConnectionInfoRow" Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="IpCard" Style="{StaticResource Card}" Margin="0,0,9,0" Padding="10,8" Height="40"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="IP" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock FlowDirection="LeftToRight" Grid.Column="1" Text="{Binding ExitIp}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
       <Border x:Name="RegionCard" Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,9,0" Padding="10,8" Height="40"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{local:Loc 国家}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Region}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
       <Border x:Name="DataCenterCard" Grid.Column="2" Style="{StaticResource Card}" Margin="9,0,9,0" Padding="10,8" Height="40"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{local:Loc 数据中心}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock FlowDirection="LeftToRight" Grid.Column="1" Text="{Binding DataCenter}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
       <Border x:Name="LatencyCard" Grid.Column="3" Style="{StaticResource Card}" Margin="9,0,0,0" Padding="10,8" Height="40"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{local:Loc 延迟}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock FlowDirection="LeftToRight" Grid.Column="1" Text="{Binding Latency}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
      </Grid>
      <Border x:Name="TrafficCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{local:Loc ↑  上传}" Style="{StaticResource Muted}"/><TextBlock FlowDirection="LeftToRight" Text="{Binding Upload}" FontSize="22" FontWeight="SemiBold" Height="30" Margin="0,6,0,4"/><local:TrafficChart FlowDirection="LeftToRight" x:Name="UploadChart" Series="{Binding UploadSeries}" Stroke="{DynamicResource Accent}" Height="42"/></StackPanel>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}"/>
        <StackPanel Grid.Column="2"><TextBlock Text="{local:Loc ↓  下载}" Style="{StaticResource Muted}"/><TextBlock FlowDirection="LeftToRight" Text="{Binding Download}" FontSize="22" FontWeight="SemiBold" Height="30" Margin="0,6,0,4"/><local:TrafficChart FlowDirection="LeftToRight" x:Name="DownloadChart" Series="{Binding DownloadSeries}" Stroke="#65A38A" Height="42"/></StackPanel>
       </Grid>
      </Border>
     </Grid></Grid>
     <ScrollViewer x:Name="PageScroller" Style="{StaticResource PageScrollViewer}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
        <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <TextBlock Text="{local:Loc 连接协议}" Style="{StaticResource SectionTitle}"/>
         <Grid><TextBlock Text="{local:Loc 隧道协议}" VerticalAlignment="Center"/><local:ContentComboBox x:Name="ProtocolPicker" IsEnabled="{Binding CanChangeProtocol}" HorizontalAlignment="Right" SelectedValue="{Binding Protocol}" SelectedValuePath="Tag"><ComboBoxItem Content="AmneziaWG" Tag="awg"/><ComboBoxItem Content="WireGuard" Tag="wg"/><ComboBoxItem Content="MASQUE" Tag="masque"/><ComboBoxItem Content="WARP-in-WARP" Tag="wwarp"/><ComboBoxItem Content="MASQUE-in-MASQUE" Tag="masque-mm"/><ComboBoxItem Content="MASQUE · HTTP/2" Tag="masque-h2"/></local:ContentComboBox></Grid>
         <Grid x:Name="NodeExportRow" Margin="0,10,0,0" ToolTip="{local:Localize NodeExport.Hint}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{local:Loc 导出节点配置}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
           <local:ContentComboBox x:Name="ExportFormatPicker" ItemsSource="{Binding NodeExport.Formats}" DisplayMemberPath="Label" SelectedValue="{Binding NodeExport.Format}" SelectedValuePath="Id" IsEnabled="{Binding NodeExport.CanChooseFormat}" ToolTipService.ShowOnDisabled="True" ToolTip="{local:Localize NodeExport.Hint}" AutomationProperties.Name="{local:Loc 节点导出格式}"/>
           <Button x:Name="CopyNodeButton" MinWidth="0" Height="28" Padding="8,3" Margin="8,0,0,0" Click="CopyNodeConfig" IsEnabled="{Binding NodeExport.CanCopy}" AutomationProperties.Name="{local:Localize NodeExport.ButtonLabel}" ToolTipService.ShowOnDisabled="True" ToolTip="{local:Localize NodeExport.Hint}">
            <Grid><TextBlock Text="{local:Loc 复制}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding NodeExport.Copied}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
             <Path x:Name="NodeCopySuccessMark" Data="M 1,7 L 5,11 L 13,2" Width="14" Height="14" Stretch="Uniform" Stroke="#279453" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="{Binding NodeExport.Copied, Converter={StaticResource BoolVisibility}}"/>
            </Grid>
           </Button>
          </StackPanel>
         </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel><TextBlock Text="{local:Loc 外观}" Style="{StaticResource SectionTitle}"/><Grid><TextBlock Text="{local:Loc 主题}" VerticalAlignment="Center"/><local:ContentComboBox HorizontalAlignment="Right" SelectedValue="{Binding Theme}" SelectedValuePath="Tag"><ComboBoxItem Content="{local:Loc 浅色}" Tag="light"/><ComboBoxItem Content="{local:Loc 深色}" Tag="dark"/><ComboBoxItem Content="{local:Loc 跟随系统}" Tag="auto"/></local:ContentComboBox></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc 语言}" VerticalAlignment="Center"/>
        <local:ContentComboBox x:Name="LanguagePicker" HorizontalAlignment="Right" SelectedValue="{Binding Language}" SelectedValuePath="Tag" AutomationProperties.Name="{local:Loc 语言}">
         <ComboBoxItem Content="简体中文" Tag="zh"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="فارسی" Tag="fa"/>
        </local:ContentComboBox>
       </Grid></StackPanel></Border>
       <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="{local:Loc 连接行为}" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="AutoConnectAfterPrepareSetting" Content="{local:Loc 优选完成后自动连接 VPN}" IsChecked="{Binding AutoConnectAfterPrepare}"/>
        <CheckBox Content="{local:Loc 连接前检查节点可用性}" IsChecked="{Binding VerifyBeforeConnect}" Margin="0,10,0,0" ToolTip="{local:Loc 关闭：真实 HTTPS 连通并接管流量后显示已连接，后台继续载荷验证；失败会恢复代理并断开。开启：全部验证通过后再显示已连接。}"/>
        <Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc 优选强度}" VerticalAlignment="Center"/><local:ScanIntensitySlider x:Name="ScanIntensityPicker" Intensity="{Binding ScanIntensity}" HorizontalAlignment="Right"/></Grid>
        <CheckBox x:Name="CacheNeverExpiresSetting" Content="{local:Loc 缓存永不过期}" IsChecked="{Binding CacheNeverExpires}" Margin="0,10,0,0"/>
        <Grid x:Name="CacheDaysRow" IsEnabled="{Binding CanEditCacheDays}"><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource SettingRow}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style></Grid.Style><TextBlock Text="{local:Loc 缓存有效期（天）}" VerticalAlignment="Center"/><TextBox FlowDirection="LeftToRight" x:Name="CacheDaysInput" Text="{Binding CacheDays}" HorizontalAlignment="Right"/></Grid>
        <Grid Style="{StaticResource SettingRow}" Margin="0,8,0,0"><TextBlock Text="{local:Loc 探测超时（秒）}" VerticalAlignment="Center"/><TextBox FlowDirection="LeftToRight" Text="{Binding Timeout}" HorizontalAlignment="Right"/></Grid>
       </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel><TextBlock Text="{local:Loc 启动与窗口}" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="CloseToTraySetting" Content="{local:Loc 关闭窗口后，在托盘继续运行}" IsChecked="{Binding CloseToTray}"/><CheckBox x:Name="AutoStartSetting" Content="{local:Loc 开机自启动}" IsChecked="{Binding AutoStart}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="{local:Loc 网络}" Style="{StaticResource SectionTitle}"/>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc 本地代理端口}" VerticalAlignment="Center"/><TextBox FlowDirection="LeftToRight" Text="{Binding MixedPort}" HorizontalAlignment="Right"/></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc 地址族}" VerticalAlignment="Center"/><local:ContentComboBox HorizontalAlignment="Right" SelectedValue="{Binding Family}" SelectedValuePath="Tag"><ComboBoxItem Content="IPv4" Tag="v4"/><ComboBoxItem Content="IPv6" Tag="v6"/><ComboBoxItem Content="{local:Loc 双栈}" Tag="both"/></local:ContentComboBox></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc MTU（0 为自动）}" VerticalAlignment="Center"/><TextBox FlowDirection="LeftToRight" Text="{Binding Mtu}" HorizontalAlignment="Right"/></Grid>
       <CheckBox x:Name="AllowLanSetting" Content="{local:Loc 允许局域网访问}" IsChecked="{Binding AllowLan}" Margin="0,8,0,0"/>
       <TextBlock x:Name="LanProxyEndpoints" Text="{local:Localize LanProxyEndpoints}" Visibility="{Binding AllowLan, Converter={StaticResource BoolVisibility}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel></Border>
       <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="DNS" Style="{StaticResource SectionTitle}"/>
        <Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc 自定义 DNS}" VerticalAlignment="Center"/><TextBox FlowDirection="LeftToRight" x:Name="CustomDnsInput" Text="{Binding Dns}" HorizontalAlignment="Right" ToolTip="{local:Loc 多个解析器使用逗号分隔}"/></Grid>
        <TextBlock x:Name="DefaultDnsHint" Text="{local:Loc 留空则使用默认 DNS 1.1.1.1}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
        <CheckBox Content="{local:Loc DNS 防泄漏}" IsChecked="{Binding DnsLeak}"/><CheckBox Content="{local:Loc 不向隧道下发 DNS}" IsChecked="{Binding DnsOff}" Margin="0,10,0,0"/>
       </StackPanel></Border>
     </StackPanel>
     <Grid x:Name="AboutPage" Visibility="Collapsed" VerticalAlignment="Top">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="ProductCard" Style="{StaticResource AboutCard}" Margin="0,0,6,6"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Column="1" Text="XEHN" Style="{StaticResource AboutCardTitle}"/><Image Source="{x:Static local:Branding.Image}" Width="24" Height="24" Margin="0,0,10,8"/><TextBlock FlowDirection="LeftToRight" HorizontalAlignment="Left" x:Name="ProductVersion" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding AppVersion}" FontSize="14" Margin="0,0,0,4"/></Grid><TextBlock x:Name="ProjectLinkText" Margin="0,4,0,8"><Hyperlink Style="{StaticResource AboutLink}" NavigateUri="https://github.com/FuckGFWall/trashvpn-windows" RequestNavigate="NavigateProject"><Run Text="{local:Loc GitHub 项目主页 ↗}"/></Hyperlink></TextBlock></StackPanel>
        <TextBlock x:Name="AppUpdateStatus" Grid.Row="1" Text="{local:Localize AppUpdateDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <Border Grid.Row="2" Style="{StaticResource AboutActionSurface}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,-4">
         <local:ResourceFeedbackButton x:Name="AppUpdateCheckButton" Content="{local:Localize AppUpdateActionLabel}" Tag="{Binding AppDownloadUrl}" IsWorking="{Binding AppUpdateChecking}" IsSuccessful="{Binding AppUpdateCheckSucceeded}" IsEnabled="{Binding CanCheckAppUpdate}" Click="CheckAppUpdate"/>
        </StackPanel>
      </Grid></Border>
      <Border x:Name="CoreCard" MinHeight="172" Grid.Column="1" Style="{StaticResource AboutCard}" Margin="6,0,0,6"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Column="1" Text="mihomo" Style="{StaticResource AboutCardTitle}"/><TextBlock Text="&#xE950;" Style="{StaticResource AboutIcon}"/><TextBlock x:Name="CoreVersionText" Grid.ColumnSpan="2" Grid.Row="1" Text="{local:Localize CoreVersion}" FontSize="14" Margin="0,0,0,4"/></Grid>
       <Border Grid.Row="3" Style="{StaticResource AboutActionSurface}"/>
       <Grid x:Name="CoreActions" Grid.Row="3" Margin="0,6,0,-4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <local:ResourceFeedbackButton x:Name="CoreCheckButton" IsWorking="{Binding CoreResourceWorking}" IsSuccessful="{Binding CoreResourceSucceeded}" Content="{local:Localize CoreResourceActionLabel}" Tag="{Binding CoreResourceActionCommand}" Click="ResourceAction" IsEnabled="{Binding CanRunCoreResourceAction}" />
       </Grid>
       <StackPanel x:Name="CoreFeedback" Grid.Row="2" Height="40"><ProgressBar x:Name="CoreDownloadBar" Minimum="0" Maximum="100" Height="5" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" Value="{Binding CoreDownloadProgress, Mode=OneWay}" IsIndeterminate="{Binding CoreDownloadIndeterminate}" Visibility="{Binding CoreDownloadActive, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{local:Localize CoreResourceDetail}" ToolTip="{local:Localize CoreResourceDetail}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ResourceDetailText}"><Setter Property="MaxHeight" Value="32"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Style.Triggers><DataTrigger Binding="{Binding CoreDownloadActive}" Value="True"><Setter Property="MaxHeight" Value="16"/><Setter Property="TextWrapping" Value="NoWrap"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
      </Grid></Border>
      <Border x:Name="GeoCard" MinHeight="172" Grid.Row="1" Style="{StaticResource AboutCard}" Margin="0,6,6,0"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Column="1" Text="GeoFiles" Style="{StaticResource AboutCardTitle}"/><TextBlock Text="&#xE774;" Style="{StaticResource AboutIcon}"/><TextBlock Grid.ColumnSpan="2" Grid.Row="1" Margin="0,4,0,0"><Run Text="{local:Loc 上次更新：}"/><Run Text="{local:Localize GeoUpdated}"/></TextBlock></Grid>
       <Border Grid.Row="3" Style="{StaticResource AboutActionSurface}"/>
       <Grid x:Name="GeoActions" Grid.Row="3" Margin="0,6,0,-4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <local:ResourceFeedbackButton x:Name="GeoCheckButton" IsWorking="{Binding GeoResourceWorking}" IsSuccessful="{Binding GeoResourceSucceeded}" Content="{local:Localize GeoResourceActionLabel}" Tag="{Binding GeoResourceActionCommand}" Click="ResourceAction" IsEnabled="{Binding CanRunGeoResourceAction}" />
       </Grid>
       <StackPanel x:Name="GeoFeedback" Grid.Row="2" Height="40"><ProgressBar x:Name="GeoDownloadBar" Minimum="0" Maximum="100" Height="5" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" Value="{Binding GeoDownloadProgress, Mode=OneWay}" IsIndeterminate="{Binding GeoDownloadIndeterminate}" Visibility="{Binding GeoDownloadActive, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{local:Localize GeoResourceDetail}" ToolTip="{local:Localize GeoResourceDetail}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ResourceDetailText}"><Setter Property="MaxHeight" Value="32"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Style.Triggers><DataTrigger Binding="{Binding GeoDownloadActive}" Value="True"><Setter Property="MaxHeight" Value="16"/><Setter Property="TextWrapping" Value="NoWrap"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
      </Grid></Border>
      <Border x:Name="CreditsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource AboutCard}" Margin="6,6,0,0"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="{local:Loc 开源与致谢}" Style="{StaticResource AboutCardTitle}"/><TextBlock Text="&#xE8F1;" Style="{StaticResource AboutIcon}"/></Grid><TextBlock Margin="0,4,0,8"><Hyperlink Style="{StaticResource AboutLink}" NavigateUri="https://github.com/hezhanleiok/xehn" RequestNavigate="NavigateProject"><Run Text="{local:Loc 原项目 XEHN ↗}"/></Hyperlink></TextBlock><TextBlock Margin="0,0,0,0"><Hyperlink Style="{StaticResource AboutLink}" NavigateUri="https://github.com/MetaCubeX/mihomo" RequestNavigate="NavigateProject"><Run Text="{local:Loc mihomo 内核 ↗}"/></Hyperlink></TextBlock></StackPanel>
       <Border Grid.Row="2" Style="{StaticResource AboutActionSurface}"/>
       <Button Style="{StaticResource AboutActionButton}" Grid.Row="2" Content="{local:Loc 第三方许可}" Click="OpenNotices" HorizontalAlignment="Left" Margin="0,6,0,-4" />
      </Grid></Border>
     </Grid>
     </Grid></ScrollViewer>
     <Grid x:Name="LogsPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="LogsCard" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,28,0"/>
      <Grid x:Name="LogsToolbar" Margin="18,12,46,10"><TextBlock Text="{local:Loc 运行日志}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/><Button x:Name="CopyLogsButton" Content="{local:Loc 复制日志}" Click="CopyLogs" HorizontalAlignment="Right" Padding="14,6"/></Grid>
      <ScrollViewer x:Name="LogScroller" Grid.Row="1" Margin="0,0,34,12" Style="{StaticResource PageScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <TextBox x:Name="LogText" FlowDirection="LeftToRight" Margin="18,0,18,16" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Width="Auto" Height="Auto" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/></ControlTemplate></TextBox.Template></TextBox>
      </ScrollViewer>
     </Grid>
   </Grid>
   <TextBlock Grid.Row="2" Text="{local:Localize Notice}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,8,28,0"/>
  </Grid>
 </Grid>
</Window>
