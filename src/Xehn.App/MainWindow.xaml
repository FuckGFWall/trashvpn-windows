<Window x:Class="Xehn.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xehn.App" Title="XEHN" Width="1120" Height="820" MinWidth="920" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
 <Grid Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="16,30,16,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,12,0,36" Orientation="Horizontal"><Border Background="{DynamicResource Accent}" Width="44" Height="44" CornerRadius="13"><TextBlock Text="X" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="XEHN" FontSize="26" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1">
     <RadioButton x:Name="HomeNav" GroupName="Navigation" IsChecked="True" Style="{StaticResource Nav}" Tag="Home" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="首页" FontSize="21"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="Settings" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="设置" FontSize="21"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="About" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="关于" FontSize="21"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="Logs" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="日志" FontSize="21"/></StackPanel></RadioButton>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="12,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="{DynamicResource Accent}" Width="6" Height="6" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" FontSize="12"/></StackPanel><TextBlock Text="FLUENT EDITION  /  0.1" Style="{StaticResource Muted}" FontSize="9" Margin="0,10,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="36,28,36,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PageHeader" Visibility="Collapsed" Margin="0,7,0,18"><TextBlock x:Name="PageTitle" Text="首页" FontSize="30" FontWeight="SemiBold"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="HomePage">
      <Border Style="{StaticResource Card}" Padding="28,42,28,46">
       <StackPanel>
        <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
        <Grid Height="190" Margin="0,6,0,0">
         <Ellipse Width="192" Height="192" Fill="{DynamicResource TintBrush}" Opacity="0.6"/>
         <Ellipse Width="168" Height="168" Stroke="{DynamicResource Accent}" StrokeThickness="1" Opacity="0.18"/>
         <Button x:Name="PowerButton" Width="142" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ToggleConnection" ToolTip="{Binding PowerLabel}" AutomationProperties.Name="{Binding PowerLabel}" Cursor="Hand">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="circle" CornerRadius="80" Background="{DynamicResource Accent}"><Viewbox Width="54" Height="54"><Grid Width="48" Height="48"><Path Data="M 13,9 A 18,18 0 1 0 35,9" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M 24,3 L 24,23" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Viewbox></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="circle" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="circle" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="circle" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
         </Button>
        </Grid>
        <StackPanel Width="420" HorizontalAlignment="Center" Margin="0,16,0,0">
         <TextBlock Text="{Binding RegistrationText}" FontSize="12" Margin="0,0,0,5"/>
         <ProgressBar x:Name="RegistrationBar" Minimum="0" Maximum="100" Value="{Binding RegistrationProgress, Mode=OneWay}" IsIndeterminate="{Binding RegistrationIndeterminate}" Height="5" Foreground="{DynamicResource Accent}"/>
          <TextBlock Text="{Binding ScanText}" FontSize="12" Margin="0,10,0,5" TextWrapping="Wrap" MinHeight="32"/>
         <ProgressBar x:Name="ScanBar" Minimum="0" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}" IsIndeterminate="{Binding ScanIndeterminate}" Height="5" Foreground="{DynamicResource Accent}"/>
        </StackPanel>
        <Grid Width="528" HorizontalAlignment="Center" Margin="0,16,0,0" IsEnabled="{Binding CanConfigure}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Background="{DynamicResource RailBrush}" CornerRadius="11" Padding="4"><UniformGrid Columns="2"><RadioButton Content="代理" GroupName="Capture" IsChecked="{Binding ProxySelected}" Style="{StaticResource Segment}"/><RadioButton Content="TUN" GroupName="Capture" IsChecked="{Binding TunSelected}" Style="{StaticResource Segment}"/></UniformGrid></Border>
         <Border Grid.Column="2" Background="{DynamicResource RailBrush}" CornerRadius="11" Padding="4" ToolTip="分流：使用 GeoIP / GeoSite 绕过中国大陆"><UniformGrid Columns="2"><RadioButton Content="全局" GroupName="Routing" IsChecked="{Binding GlobalSelected}" Style="{StaticResource Segment}"/><RadioButton Content="分流" GroupName="Routing" IsChecked="{Binding SplitSelected}" Style="{StaticResource Segment}"/></UniformGrid></Border>
        </Grid>
       </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,16,0,0">
       <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20"><StackPanel><TextBlock Text="出口 IP" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ExitIp}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" Height="25"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0,5,0" Padding="20"><StackPanel><TextBlock Text="国家 / 地区" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Region}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" Height="25"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="20"><StackPanel><TextBlock Text="延迟" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Latency}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" Height="25"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,20">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="↑  上传" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Upload}" FontSize="24" FontWeight="SemiBold" Height="36" Margin="0,8,0,6"/><local:TrafficChart Values="{Binding UploadSamples}" Stroke="{DynamicResource Accent}" Height="48"/></StackPanel>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}"/>
        <StackPanel Grid.Column="2"><TextBlock Text="↓  下载" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Download}" FontSize="24" FontWeight="SemiBold" Height="36" Margin="0,8,0,6"/><local:TrafficChart Values="{Binding DownloadSamples}" Stroke="#65A38A" Height="48"/></StackPanel>
       </Grid>
      </Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource SettingsCard}" IsEnabled="{Binding CanChangeProtocol}"><StackPanel>
       <TextBlock Text="连接协议" Style="{StaticResource SectionTitle}"/>
       <Grid><TextBlock Text="隧道协议" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" SelectedValue="{Binding Protocol}" SelectedValuePath="Tag"><ComboBoxItem Content="AmneziaWG" Tag="awg"/><ComboBoxItem Content="WireGuard" Tag="wg"/><ComboBoxItem Content="MASQUE" Tag="masque"/><ComboBoxItem Content="MASQUE · HTTP/2" Tag="masque-h2"/><ComboBoxItem Content="WARP-in-WARP" Tag="wwarp"/><ComboBoxItem Content="MASQUE-in-MASQUE" Tag="masque-mm"/></ComboBox></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel><TextBlock Text="外观" Style="{StaticResource SectionTitle}"/><Grid><TextBlock Text="主题" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" SelectedValue="{Binding Theme}" SelectedValuePath="Tag"><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/><ComboBoxItem Content="跟随系统" Tag="auto"/></ComboBox></Grid></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="网络" Style="{StaticResource SectionTitle}"/>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="本地代理端口" VerticalAlignment="Center"/><TextBox Text="{Binding MixedPort}" HorizontalAlignment="Right" Width="160"/></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="API 端口" VerticalAlignment="Center"/><TextBox Text="{Binding ApiPort}" HorizontalAlignment="Right" Width="160"/></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="地址族" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" SelectedValue="{Binding Family}" SelectedValuePath="Tag"><ComboBoxItem Content="IPv4" Tag="v4"/><ComboBoxItem Content="IPv6" Tag="v6"/><ComboBoxItem Content="双栈" Tag="both"/></ComboBox></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="MTU（0 为自动）" VerticalAlignment="Center"/><TextBox Text="{Binding Mtu}" HorizontalAlignment="Right" Width="160"/></Grid>
       <CheckBox Content="允许局域网访问" IsChecked="{Binding AllowLan}" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="DNS" Style="{StaticResource SectionTitle}"/><Grid Style="{StaticResource SettingRow}"><TextBlock Text="自定义 DNS" VerticalAlignment="Center"/><TextBox Text="{Binding Dns}" Width="280" HorizontalAlignment="Right" ToolTip="多个解析器使用逗号分隔；留空使用引擎默认值"/></Grid><CheckBox Content="DNS 防泄漏" IsChecked="{Binding DnsLeak}"/><CheckBox Content="不向隧道下发 DNS" IsChecked="{Binding DnsOff}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="连接行为" Style="{StaticResource SectionTitle}"/><CheckBox Content="启动后自动连接" IsChecked="{Binding AutoConnect}"/><CheckBox Content="连接前检查节点可用性" IsChecked="{Binding VerifyBeforeConnect}" Margin="0,10,0,0" ToolTip="关闭：核心启动后先显示已连接（检测中），随后检测失败会立即断开。"/><Grid Style="{StaticResource SettingRow}"><TextBlock Text="优选强度" VerticalAlignment="Center"/><ComboBox SelectedValue="{Binding ScanIntensity}" SelectedValuePath="Tag" HorizontalAlignment="Right"><ComboBoxItem Content="低 · 较快" Tag="low"/><ComboBoxItem Content="中 · 均衡" Tag="medium"/><ComboBoxItem Content="高 · 更多候选" Tag="high"/></ComboBox></Grid><CheckBox Content="每次连接重新扫描" IsChecked="{Binding Rescan}" Margin="0,10,0,0"/><CheckBox Content="连接异常时自动修复" IsChecked="{Binding AutoRepair}" Margin="0,10,0,0"/><Grid Style="{StaticResource SettingRow}" Margin="0,8,0,0"><TextBlock Text="探测超时（秒）" VerticalAlignment="Center"/><TextBox Text="{Binding Timeout}" HorizontalAlignment="Right" Width="160"/></Grid></StackPanel></Border>
      <TextBlock Text="网络设置在断开后可修改；所有设置自动保存在独立数据目录。" Style="{StaticResource Muted}" Margin="4,16,0,0"/>
     </StackPanel>
     <StackPanel x:Name="AboutPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="XEHN" FontSize="32" FontWeight="Bold"/><TextBlock Text="Fluent Edition 0.1  ·  C# / WPF / .NET 10" Margin="0,16,0,0"/><TextBlock Text="WARP engine by XEHN · Traffic powered by mihomo" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Geo 数据库" Style="{StaticResource SectionTitle}"/><TextBlock Text="GeoIP + GeoSite" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding GeoStatus}" TextWrapping="Wrap" Margin="0,18,0,18"/><StackPanel Orientation="Horizontal" IsEnabled="{Binding CanConfigure}"><Button Content="检查数据库" Click="CheckGeo" Padding="18,8"/><Button Content="下载缺失数据库" Click="RepairGeo" Padding="18,8" Margin="10,0,0,0"/></StackPanel><TextBlock Text="来源：MetaCubeX / meta-rules-dat" Style="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="开源与致谢" Style="{StaticResource SectionTitle}"/><WrapPanel><Button Content="原项目 ↗" Tag="https://github.com/hezhanleiok/xehn" Click="OpenLink"/><Button Content="mihomo ↗" Tag="https://github.com/MetaCubeX/mihomo" Click="OpenLink" Margin="10,0,0,0"/><Button Content="第三方许可" Click="OpenNotices" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
     </StackPanel>
     <Grid x:Name="LogsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="480" FontFamily="Cascadia Mono, Consolas" FontSize="12"/><Button Content="复制日志" Click="CopyLogs" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></Grid>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="2" Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
