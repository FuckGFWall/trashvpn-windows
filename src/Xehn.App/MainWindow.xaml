<Window x:Class="Xehn.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xehn.App" Title="XEHN" Icon="{x:Static local:Branding.Image}" Width="980" Height="760" MinWidth="880" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
 <Grid Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="12,22,12,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="6,8,0,28" Orientation="Horizontal"><Image x:Name="BrandIcon" Source="{x:Static local:Branding.Image}" Width="34" Height="34" Stretch="Uniform"/><TextBlock Text="XEHN" FontSize="22" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1">
     <RadioButton x:Name="HomeNav" GroupName="Navigation" IsChecked="True" Style="{StaticResource Nav}" Tag="Home" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="首页" FontSize="16"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="Settings" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="设置" FontSize="16"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="About" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="关于" FontSize="16"/></StackPanel></RadioButton>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Tag="Logs" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="日志" FontSize="16"/></StackPanel></RadioButton>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Fill="{DynamicResource Accent}" Width="5" Height="5" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding SidebarStatus}" MaxWidth="88" ToolTip="{Binding Status}" FontSize="10.5" TextTrimming="CharacterEllipsis"/><local:ProgressRing x:Name="StatusProgressRing" Grid.Column="2" Width="12" Height="12" Margin="6,0,0,0" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" IsActive="{Binding IsStatusWorking}" Visibility="{Binding IsStatusWorking, Converter={StaticResource BoolVisibility}}"/></Grid><TextBlock Text="XEHN  /  1.0.0" Style="{StaticResource Muted}" FontSize="9" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PageHeader" Visibility="Collapsed" Margin="0,4,0,14"><TextBlock x:Name="PageTitle" Text="首页" FontSize="30" FontWeight="SemiBold"/></Grid>
   <Grid x:Name="PageContent" Grid.Row="1">
     <StackPanel x:Name="HomePage">
      <Border x:Name="ConnectionCard" Style="{StaticResource Card}" Padding="22,16,22,18">
       <StackPanel>
        <TextBlock x:Name="ConnectionHeading" Text="{Binding ConnectionHeading}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
        <Grid Height="146" Margin="0,6,0,0">
         <Ellipse Width="144" Height="144" Fill="{DynamicResource TintBrush}" Opacity="0.6"/>
         <Ellipse Width="132" Height="132" Stroke="{DynamicResource Accent}" StrokeThickness="1" Opacity="0.18"/>
         <Button x:Name="PowerButton" Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ToggleConnection" ToolTip="{Binding PowerLabel}" AutomationProperties.Name="{Binding PowerLabel}" Cursor="Hand">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="circle" CornerRadius="60" Background="{DynamicResource Accent}"><Grid><Viewbox x:Name="PowerGlyph" Width="54" Height="54"><Grid Width="48" Height="48"><Path Data="M 13,9 A 18,18 0 1 0 35,9" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M 24,3 L 24,23" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Viewbox><local:ProgressRing x:Name="PowerProgressRing" Width="84" Height="84" Stroke="White" StrokeThickness="3.5" IsActive="{Binding IsPowerWorking}" Visibility="{Binding IsPowerWorking, Converter={StaticResource BoolVisibility}}"/></Grid></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsPowerWorking}" Value="True"><Setter TargetName="PowerGlyph" Property="Visibility" Value="Collapsed"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="circle" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="circle" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="circle" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
         </Button>
        </Grid>
        <StackPanel x:Name="PreparationPanel" Width="420" HorizontalAlignment="Center" Margin="0,12,0,0">
         <TextBlock Text="{Binding RegistrationText}" FontSize="11.5" Margin="0,0,0,4"/>
         <ProgressBar x:Name="RegistrationBar" Minimum="0" Maximum="100" Value="{Binding RegistrationProgress, Mode=OneWay}" IsIndeterminate="{Binding RegistrationIndeterminate}" Height="4" Foreground="{DynamicResource Accent}"/>
          <TextBlock Text="{Binding ScanText}" FontSize="11.5" Margin="0,8,0,4" TextWrapping="Wrap" Height="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScanText}"/>
         <ProgressBar x:Name="ScanBar" Minimum="0" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}" IsIndeterminate="{Binding ScanIndeterminate}" Height="4" Foreground="{DynamicResource Accent}"/>
        </StackPanel>
        <Grid x:Name="ModeSelectors" Width="480" HorizontalAlignment="Center" Margin="0,40,0,0" IsEnabled="{Binding CanChangeModes}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Background="{DynamicResource RailBrush}" CornerRadius="11" Padding="4"><UniformGrid Columns="2"><RadioButton Content="代理" GroupName="Capture" IsChecked="{Binding ProxySelected}" Style="{StaticResource Segment}"/><RadioButton Content="TUN" GroupName="Capture" IsChecked="{Binding TunSelected}" Style="{StaticResource Segment}"/></UniformGrid></Border>
         <Border Grid.Column="2" Background="{DynamicResource RailBrush}" CornerRadius="11" Padding="4" ToolTip="分流：使用 GeoIP / GeoSite 绕过中国大陆"><UniformGrid Columns="2"><RadioButton Content="全局" GroupName="Routing" IsChecked="{Binding GlobalSelected}" Style="{StaticResource Segment}"/><RadioButton Content="分流" GroupName="Routing" IsChecked="{Binding SplitSelected}" Style="{StaticResource Segment}"/></UniformGrid></Border>
        </Grid>
       </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,12,0,0">
       <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14"><StackPanel><TextBlock Text="出口 IP" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ExitIp}" ToolTip="{Binding ExitIp}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" Height="22"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="14"><StackPanel><TextBlock Text="国家 / 地区" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Region}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" Height="22"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="14"><StackPanel><TextBlock Text="延迟" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Latency}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" Height="22"/></StackPanel></Border>
      </UniformGrid>
      <Border x:Name="TrafficCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="↑  上传" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Upload}" FontSize="22" FontWeight="SemiBold" Height="30" Margin="0,6,0,4"/><local:TrafficChart x:Name="UploadChart" Series="{Binding UploadSeries}" Stroke="{DynamicResource Accent}" Height="42"/></StackPanel>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}"/>
        <StackPanel Grid.Column="2"><TextBlock Text="↓  下载" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Download}" FontSize="22" FontWeight="SemiBold" Height="30" Margin="0,6,0,4"/><local:TrafficChart x:Name="DownloadChart" Series="{Binding DownloadSeries}" Stroke="#65A38A" Height="42"/></StackPanel>
       </Grid>
      </Border>
     </StackPanel>
     <ScrollViewer x:Name="PageScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource SettingsCard}" IsEnabled="{Binding CanChangeProtocol}"><StackPanel>
       <TextBlock Text="连接协议" Style="{StaticResource SectionTitle}"/>
       <Grid><TextBlock Text="隧道协议" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" SelectedValue="{Binding Protocol}" SelectedValuePath="Tag"><ComboBoxItem Content="AmneziaWG" Tag="awg"/><ComboBoxItem Content="WireGuard" Tag="wg"/><ComboBoxItem Content="MASQUE" Tag="masque"/><ComboBoxItem Content="MASQUE · HTTP/2" Tag="masque-h2"/><ComboBoxItem Content="WARP-in-WARP" Tag="wwarp"/><ComboBoxItem Content="MASQUE-in-MASQUE" Tag="masque-mm"/></ComboBox></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel><TextBlock Text="外观" Style="{StaticResource SectionTitle}"/><Grid><TextBlock Text="主题" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" SelectedValue="{Binding Theme}" SelectedValuePath="Tag"><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/><ComboBoxItem Content="跟随系统" Tag="auto"/></ComboBox></Grid></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel><TextBlock Text="启动与窗口" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="CloseToTraySetting" Content="关闭窗口后，在托盘继续运行" IsChecked="{Binding CloseToTray}"/><CheckBox x:Name="AutoStartSetting" Content="开机自启动" IsChecked="{Binding AutoStart}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="网络" Style="{StaticResource SectionTitle}"/>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="本地代理端口" VerticalAlignment="Center"/><TextBox Text="{Binding MixedPort}" HorizontalAlignment="Right"/></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="API 端口" VerticalAlignment="Center"/><TextBox Text="{Binding ApiPort}" HorizontalAlignment="Right"/></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="地址族" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" SelectedValue="{Binding Family}" SelectedValuePath="Tag"><ComboBoxItem Content="IPv4" Tag="v4"/><ComboBoxItem Content="IPv6" Tag="v6"/><ComboBoxItem Content="双栈" Tag="both"/></ComboBox></Grid>
       <Grid Style="{StaticResource SettingRow}"><TextBlock Text="MTU（0 为自动）" VerticalAlignment="Center"/><TextBox Text="{Binding Mtu}" HorizontalAlignment="Right"/></Grid>
       <CheckBox Content="允许局域网访问" IsChecked="{Binding AllowLan}" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="DNS" Style="{StaticResource SectionTitle}"/><Grid Style="{StaticResource SettingRow}"><TextBlock Text="自定义 DNS" VerticalAlignment="Center"/><TextBox x:Name="CustomDnsInput" Text="{Binding Dns}" HorizontalAlignment="Right" ToolTip="多个解析器使用逗号分隔；留空使用引擎默认值"/></Grid><CheckBox Content="DNS 防泄漏" IsChecked="{Binding DnsLeak}"/><CheckBox Content="不向隧道下发 DNS" IsChecked="{Binding DnsOff}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" IsEnabled="{Binding CanConfigure}"><StackPanel><TextBlock Text="连接行为" Style="{StaticResource SectionTitle}"/><CheckBox Content="启动后自动连接" IsChecked="{Binding AutoConnect}"/><CheckBox Content="连接前检查节点可用性" IsChecked="{Binding VerifyBeforeConnect}" Margin="0,10,0,0" ToolTip="关闭：核心启动后首页先显示已连接，同时用转圈动画表示正在验证；检测失败会立即断开。"/><Grid Style="{StaticResource SettingRow}"><TextBlock Text="优选强度" VerticalAlignment="Center"/><ComboBox SelectedValue="{Binding ScanIntensity}" SelectedValuePath="Tag" HorizontalAlignment="Right"><ComboBoxItem Content="低 · 较快" Tag="low"/><ComboBoxItem Content="中 · 均衡" Tag="medium"/><ComboBoxItem Content="高 · 更多候选" Tag="high"/></ComboBox></Grid><CheckBox Content="每次连接重新扫描" IsChecked="{Binding Rescan}" Margin="0,10,0,0"/><CheckBox Content="连接异常时自动修复" IsChecked="{Binding AutoRepair}" Margin="0,10,0,0"/><Grid Style="{StaticResource SettingRow}" Margin="0,8,0,0"><TextBlock Text="探测超时（秒）" VerticalAlignment="Center"/><TextBox Text="{Binding Timeout}" HorizontalAlignment="Right"/></Grid></StackPanel></Border>
      <TextBlock Text="代理 / TUN 与全局 / 分流支持热切换；其他网络设置需断开后修改。" Style="{StaticResource Muted}" Margin="4,16,0,0"/>
     </StackPanel>
     <Grid x:Name="AboutPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="ProductCard" Style="{StaticResource Card}" Margin="0,0,8,8" MinHeight="228"><StackPanel>
       <TextBlock Text="XEHN" FontSize="28" FontWeight="Bold"/>
       <TextBlock x:Name="ProductVersion" Text="{Binding AppVersion}" FontSize="18" Margin="0,20,0,22"/>
       <TextBlock><Hyperlink NavigateUri="https://github.com/FuckGFWall/trashvpn-windows" RequestNavigate="NavigateProject" Foreground="{DynamicResource Accent}">GitHub 项目主页 ↗</Hyperlink></TextBlock>
      </StackPanel></Border>
      <Border x:Name="CoreCard" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,8" MinHeight="228"><StackPanel>
       <TextBlock Text="mihomo" Style="{StaticResource SectionTitle}" FontSize="22"/>
       <TextBlock Text="{Binding CoreVersion}" FontSize="17" Margin="0,10,0,4"/>
       <TextBlock Text="{Binding CoreCheckText}" Style="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="34"/>
       <WrapPanel Margin="0,16,0,0"><Button Content="检查" Tag="resources-check-core" Click="ResourceAction" IsEnabled="{Binding CanCheckResources}" Padding="16,7"/><Button Content="下载 mihomo" Tag="resources-download-core" Click="ResourceAction" IsEnabled="{Binding CanDownloadCore}" Visibility="{Binding CoreNeedsDownload, Converter={StaticResource BoolVisibility}}" Margin="10,0,0,0" Padding="14,7" ToolTip="断开 VPN 后下载安装；新内核通过全部协议检查后才替换旧内核。"/></WrapPanel>
       <ProgressBar x:Name="CoreDownloadBar" Minimum="0" Maximum="100" Height="5" Margin="0,16,0,0" Foreground="{DynamicResource Accent}" Value="{Binding CoreDownloadProgress, Mode=OneWay}" IsIndeterminate="{Binding CoreDownloadIndeterminate}" Visibility="{Binding CoreDownloadActive, Converter={StaticResource BoolVisibility}}"/>
       <TextBlock x:Name="CoreResourceStatus" Text="{Binding CoreResourceMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border x:Name="GeoCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,8,0" MinHeight="228"><StackPanel>
       <TextBlock Text="GeoFiles" Style="{StaticResource SectionTitle}" FontSize="22"/>
       <TextBlock Margin="0,18,0,30"><Run Text="上次更新："/><Run Text="{Binding GeoUpdated, Mode=OneWay}"/></TextBlock>
       <WrapPanel><Button Content="检查" Tag="resources-info" Click="ResourceAction" IsEnabled="{Binding CanCheckResources}" Padding="16,7"/><Button Content="下载 GeoFiles" Tag="resources-download-geo" Click="ResourceAction" IsEnabled="{Binding CanDownloadGeo}" Visibility="{Binding GeoNeedsDownload, Converter={StaticResource BoolVisibility}}" Margin="10,0,0,0" Padding="14,7"/></WrapPanel>
       <ProgressBar x:Name="GeoDownloadBar" Minimum="0" Maximum="100" Height="5" Margin="0,16,0,0" Foreground="{DynamicResource Accent}" Value="{Binding GeoDownloadProgress, Mode=OneWay}" IsIndeterminate="{Binding GeoDownloadIndeterminate}" Visibility="{Binding GeoDownloadActive, Converter={StaticResource BoolVisibility}}"/>
       <TextBlock x:Name="GeoResourceStatus" Text="{Binding GeoResourceMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border x:Name="CreditsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,8,0,0" MinHeight="228"><StackPanel>
       <TextBlock Text="开源与致谢" Style="{StaticResource SectionTitle}" FontSize="22"/>
       <TextBlock Margin="0,18,0,12"><Hyperlink NavigateUri="https://github.com/hezhanleiok/xehn" RequestNavigate="NavigateProject" Foreground="{DynamicResource Accent}">原项目 XEHN ↗</Hyperlink></TextBlock>
       <TextBlock Margin="0,0,0,18"><Hyperlink NavigateUri="https://github.com/MetaCubeX/mihomo" RequestNavigate="NavigateProject" Foreground="{DynamicResource Accent}">mihomo 内核 ↗</Hyperlink></TextBlock>
       <Button Content="第三方许可" Click="OpenNotices" HorizontalAlignment="Left" Padding="16,7"/>
      </StackPanel></Border>
     </Grid>
     <Grid x:Name="LogsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Width="Auto" Height="440" FontFamily="Cascadia Mono, Consolas" FontSize="12"/><Button Content="复制日志" Click="CopyLogs" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></Grid>
     </Grid></ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="2" Text="{Binding Notice}" ToolTip="{Binding Notice}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,8,0,0"/>
  </Grid>
 </Grid>
</Window>
