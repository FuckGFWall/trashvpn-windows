<UserControl x:Class="Xehn.App.ModeSwitch" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="46" Focusable="False">
 <UserControl.Resources>
  <Style x:Key="Choice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border Background="Transparent" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource RailBrush}" CornerRadius="12" Padding="4">
  <Grid x:Name="Track" SizeChanged="TrackSizeChanged">
   <Border x:Name="SelectionThumb" Background="{DynamicResource CardBrush}" CornerRadius="10" HorizontalAlignment="Left" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform></Border>
   <UniformGrid Columns="2"><RadioButton x:Name="FirstChoice" Content="{Binding FirstText, ElementName=Root}" Style="{StaticResource Choice}" Checked="ChoiceChecked"/><RadioButton x:Name="SecondChoice" Content="{Binding SecondText, ElementName=Root}" Style="{StaticResource Choice}" Checked="ChoiceChecked"/></UniformGrid>
  </Grid>
 </Border>
</UserControl>
